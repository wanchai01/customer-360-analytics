# --- Secrets ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Data (generated locally, not committed) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/sample/*.csv
*.parquet

# --- Spark ---
spark-warehouse/
metastore_db/
derby.log

# --- Airflow ---
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py

# --- Docker ---
*.log

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/

# --- Power BI ---
*.pbix.bak

# --- Data Quality reports (regenerated on each run) ---
data_quality/reports/*.json
!data_quality/reports/.gitkeep
