# =========================================================
# Customer 360 Analytics Platform — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git.
# =========================================================

# ---------- PostgreSQL (Analytics Data Warehouse) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=customer360
POSTGRES_USER=customer360_app
POSTGRES_PASSWORD=change_me

# ---------- Airflow Metadata DB (separate user/db from analytics DB) ----------
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_app
AIRFLOW_DB_PASSWORD=change_me

# ---------- Airflow Core ----------
AIRFLOW__CORE__FERNET_KEY=change_me_generate_a_real_fernet_key
AIRFLOW__WEBSERVER__SECRET_KEY=change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------- AWS (leave blank for local-only development) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_S3_BUCKET=customer-360-data

# ---------- MinIO (local S3-compatible Data Lake for development) ----------
# In docker-compose, the etl service points AWS_S3_ENDPOINT_URL at MinIO and
# falls back to these credentials when AWS_ACCESS_KEY_ID/SECRET are blank.
# To deploy against real AWS S3 instead: fill in real AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY above and remove AWS_S3_ENDPOINT_URL from
# docker-compose.yml (or override it to empty) — no code changes needed.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# ---------- Spark ----------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ---------- Data Quality thresholds ----------
DQ_MIN_PASS_RATE=0.95

# ---------- Power BI read-only DB role (Phase 12 / aws/iam.md) ----------
# sql/ddl/02_powerbi_reader_role.sql creates this role with a
# placeholder password; set a real one here and run:
#   ALTER ROLE powerbi_reader WITH PASSWORD '<value below>';
# In production, this belongs in AWS Secrets Manager, not here.
POWERBI_READER_PASSWORD=change_me_immediately

# ---------- Project paths (local dev, container-relative) ----------
DATA_RAW_PATH=/opt/data/raw
DATA_PROCESSED_PATH=/opt/data/processed
DATA_CURATED_PATH=/opt/data/curated
