FROM python:3.12-slim

WORKDIR /opt/app

# System deps:
#   build-essential, libpq-dev -> compiling psycopg2 / pyarrow
#   postgresql-client          -> sql/ddl_deploy.py's psql subprocess calls
#   default-jre-headless       -> required by PySpark, which is a Python
#                                 wrapper around a real JVM (Spark Core is
#                                 written in Scala/Java) — without a JRE,
#                                 `SparkSession.builder.getOrCreate()`
#                                 fails immediately with "JAVA_HOME not set"
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        postgresql-client \
        default-jre-headless \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/default-java

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["tail", "-f", "/dev/null"]
